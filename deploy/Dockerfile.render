# The single-container image for the Render free tier.
#
# The free tier has no background worker and no private services, so the
# four runtimes (nginx, the Core API, the Ingestion API and the detection
# worker) share one container. They stay four separate OS processes with
# their own entry points; only the packaging is combined.
#
# The Docker Compose stack in `compose.yaml` keeps them in separate
# containers and is the reference deployment shape.

FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY frontend/ ./
RUN npm run build


FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NGINX_ENVSUBST_FILTER="^(PORT|CORE_UPSTREAM|INGEST_UPSTREAM)$"

RUN apt-get update \
    && apt-get install --no-install-recommends -y nginx bash gettext-base \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/pyproject.toml ./
RUN pip install --upgrade pip==25.0.1 && pip install .

COPY backend/sentinel ./sentinel
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./

COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY frontend/render-nginx-config.sh /usr/local/bin/render-nginx-config.sh
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/render-nginx-config.sh /usr/local/bin/entrypoint.sh

ENV PORT=8080 \
    CORE_UPSTREAM=http://127.0.0.1:8000 \
    INGEST_UPSTREAM=http://127.0.0.1:8001

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
