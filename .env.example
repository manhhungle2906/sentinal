# API Sentinel — local development defaults.
# Copy to .env with: cp .env.example .env
# Never commit a real .env file.

APP_ENV=development
SECRET_KEY=dev-only-secret-key-change-me
SECURE_COOKIES=false
DEMO_MODE=true

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# Host ports (loopback only).
WEB_PORT=8080
DEMO_PORT=9000

# Filled in by scripts/demo.py when it provisions the demo source.
DEMO_SOURCE_KEY=
